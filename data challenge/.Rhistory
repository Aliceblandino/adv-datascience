# ============================================================
# Serie A 1993 - oggi (football-data.co.uk)
# ============================================================
suppressPackageStartupMessages({
library(readr)
library(dplyr)
library(purrr)
library(lubridate)
})
options(timeout = 30)   # max 30 secondi per ogni download
# --- 1. Apro il sito e scarico i file delle varie stagioni ---
cartella <- "dati_serie_a"
dir.create(cartella, showWarnings = FALSE)
# Codici stagione: "9394", "9495", ..., "2526", "2627"
ultimo_inizio <- if (month(Sys.Date()) >= 8) year(Sys.Date()) else year(Sys.Date()) - 1
inizi  <- 1993:ultimo_inizio
codici <- sprintf("%02d%02d", inizi %% 100, (inizi + 1) %% 100)
scarica_stagione <- function(codice) {
url  <- paste0("https://www.football-data.co.uk/mmz4281/", codice, "/I1.csv")
file <- file.path(cartella, paste0("I1_", codice, ".csv"))
if (file.exists(file)) return(file)               # gia' scaricato: salto
message("Scarico stagione ", codice, " ...")
ok <- tryCatch({
download.file(url, file, mode = "wb", quiet = TRUE)
TRUE
}, error = function(e) {
message("  -> non scaricata: ", conditionMessage(e))
FALSE
}, warning = function(w) {
message("  -> non scaricata: ", conditionMessage(w))
FALSE
})
if (ok) file else { if (file.exists(file)) file.remove(file); NA_character_ }
}
file_scaricati <- map_chr(codici, scarica_stagione)
names(file_scaricati) <- codici
file_scaricati <- file_scaricati[!is.na(file_scaricati)]
message("Stagioni disponibili: ", length(file_scaricati), " su ", length(codici))
# --- 2. Importo i file in R ---
# --- 3. Tengo solo le colonne utili ---
colonne_utili <- c("Date", "HomeTeam", "AwayTeam", "FTHG", "FTAG")
leggi_file <- function(file) {
df <- suppressWarnings(suppressMessages(
read_csv(file,
col_types   = cols(.default = col_character()),
locale      = locale(encoding = "latin1"),
name_repair = "unique_quiet",
show_col_types = FALSE,
progress    = FALSE)
))
for (m in setdiff(colonne_utili, names(df))) df[[m]] <- NA_character_
select(df, all_of(colonne_utili))
}
dati_grezzi <- map(file_scaricati, leggi_file) %>%
list_rbind(names_to = "Season")
# --- 4. Verifico i valori non validi / filtro le righe con Date valida ---
cat("Righe importate:", nrow(dati_grezzi), "\n")
cat("Righe con Date non valida:",
sum(is.na(dmy(dati_grezzi$Date, quiet = TRUE))), "\n")
serie_a <- dati_grezzi %>%
mutate(
Date = dmy(Date, quiet = TRUE),   # gestisce dd/mm/yy e dd/mm/yyyy
FTHG = as.integer(FTHG),
FTAG = as.integer(FTAG)
) %>%
filter(!is.na(Date)) %>%
select(Date, HomeTeam, AwayTeam, FTHG, FTAG)
# --- Controlli finali ---
glimpse(serie_a)
cat("Partite totali:", nrow(serie_a), "\n")
cat("Intervallo date:", format(min(serie_a$Date)), "->", format(max(serie_a$Date)), "\n")
cat("NA per colonna:\n"); print(colSums(is.na(serie_a)))
cat("Gol negativi:", sum(serie_a$FTHG < 0 | serie_a$FTAG < 0, na.rm = TRUE), "\n")
cat("Numero di squadre:", n_distinct(c(serie_a$HomeTeam, serie_a$AwayTeam)), "\n")
