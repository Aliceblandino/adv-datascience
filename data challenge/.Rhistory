title: "Analisi demo"
install.packages("ggplot2")
install.packages("shiny")
library(ggplot2)
library(shiny)
social_media_data <- data.frame(
platform = c("Facebook", "YouTube", "WhatsApp", "Instagram", "TikTok"),
users = c(2900, 2000, 2000, 1400, 1200)
)
plot_social_media <- ggplot(social_media_data, aes(x = reorder(platform, -users), y = users)) +
geom_bar(stat = "identity", fill = "steelblue", width = 0.7) +
coord_flip() +
labs(title = "Most Used Social Media Platforms",
x = "Platform",
y = "Number of Users (Millions)") +
theme_minimal()
plot_social_media <- ggplot(social_media_data, aes(x = reorder(platform, -users), y = users)) +
geom_bar(stat = "identity", fill = "steelblue", width = 0.7) +
coord_flip() +
labs(title = "Most Used Social Media Platforms",
x = "Platform",
y = "Number of Users (Millions)") +
theme_minimal()
#Finally, create a Shiny app to make the chart interactive:
ui <- fluidPage(
titlePanel("Most Used Social Media Platforms"),
sidebarLayout(
sidebarPanel(
selectInput("platform", "Select a platform:",
choices = unique(social_media_data$platform))
),
mainPanel(
plotOutput("chart")
)
)
)
server <- function(input, output) {
output$chart <- renderPlot({
selected_data <- social_media_data[social_media_data$platform == input$platform,]
plot_social_media +
xlim(rev(levels(social_media_data$platform))) +
ggtitle(paste("Most Used Social Media Platform: ", input$platform))
})
}
shinyApp(ui = ui, server = server)
