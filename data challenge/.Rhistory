# Caricamento delle librerie necessarie
library(tidyverse)
library(lubridate)
# 1. Definizione delle stagioni da 1993-94 alla stagione corrente (es. 2025-26)
# Su football-data.co.uk le stagioni sono codificate come "9394", "9495", ..., "2526"
start_year <- 93
end_year <- 25 # Modificabile in base all'anno corrente
seasons <- c()
for (y in start_year:end_year) {
y_next <- (y + 1) %% 100
season_str <- paste0(sprintf("%02d", y), sprintf("%02d", y_next))
seasons <- c(seasons, season_str)
}
# 2. Funzione per costruire l'URL e scaricare i dati per la Serie A (codice 'I1')
# Nota: football-data.co.uk usa la struttura /mmz4281/YYYY/I1.csv
get_serie_a_data <- function(season) {
url <- paste0("https://www.football-data.co.uk/mmz4281/", season, "/I1.csv")
# Tentativo di lettura del file CSV
tryCatch({
df <- read_csv(url, show_col_types = FALSE)
# Seleziona solo le colonne richieste se presenti nel file
cols_to_select <- c("Date", "HomeTeam", "AwayTeam", "FTHG", "FTAG")
# Verifica che le colonne esistano prima di selezionarle
existing_cols <- intersect(cols_to_select, names(df))
df_filtered <- df %>% select(all_of(existing_cols))
# Aggiunge la colonna Season per tracciabilità
df_filtered$Season <- season
return(df_filtered)
}, error = function(e) {
message(paste("Impossibile scaricare la stagione:", season))
return(NULL)
})
}
# 3. Iterazione su tutte le stagioni e unione in un unico dataframe
all_matches_list <- lapply(seasons, get_serie_a_data)
serie_a_data <- bind_rows(all_matches_list)
# 4. Pulizia e filtraggio delle date non valide (NA)
# Le date su football-data possono avere formati misti (es. DD/MM/YY o DD/MM/YYYY)
serie_a_data_clean <- serie_a_data %>%
mutate(Date = dmy(Date)) %>% # Converte la stringa in formato Data (libreria lubridate)
filter(!is.na(Date), !is.na(HomeTeam), !is.na(AwayTeam))
# Anteprima dei dati puliti
head(serie_a_data_clean)
summary(serie_a_data_clean)
# Caricamento delle librerie necessarie
library(tidyverse)
library(lubridate)
# 1. Definizione delle stagioni a partire dal 1993-94 fino alla stagione corrente (2025-26)
start_year <- 93
end_year   <- 25 # Modificabile in base all'anno corrente (es. 25 per 2025/26)
seasons <- c()
for (y in start_year:end_year) {
y_next     <- (y + 1) %% 100
season_str <- paste0(sprintf("%02d", y), sprintf("%02d", y_next))
seasons    <- c(seasons, season_str)
}
# 2. Funzione per scaricare e pulire i dati di una singola stagione
get_serie_a_data <- function(season) {
url <- paste0("https://www.football-data.co.uk/mmz4281/", season, "/I1.csv")
tryCatch({
# Legge il file ignorando eventuali colonne vuote extra alla fine
df <- read_csv(url, show_col_types = FALSE, progress = FALSE)
# Rimuove le colonne senza nome (es. ...8, ...9 dovute a virgole finali nei CSV)
df <- df %>% select(-matches("^\\.\\.\\."))
# Seleziona solo le colonne richieste se presenti
cols_to_select <- c("Date", "HomeTeam", "AwayTeam", "FTHG", "FTAG")
existing_cols  <- intersect(cols_to_select, names(df))
df_filtered <- df %>% select(all_of(existing_cols))
df_filtered$Season <- season
return(df_filtered)
}, error = function(e) {
message(paste("Stagione non disponibile:", season))
return(NULL)
})
}
# 3. Scaricamento ed unione di tutte le stagioni valide
all_matches_list <- lapply(seasons, get_serie_a_data)
# Caricamento delle librerie necessarie
library(tidyverse)
library(lubridate)
# 1. Definizione degli anni completi (dalla stagione 1993-94 alla stagione corrente)
start_year <- 1993
end_year   <- 2025 # Modificabile con l'anno di inizio della stagione corrente (es. 2025 per 2025-26)
# Genera le stringhe delle stagioni in modo sicuro (es. "9394", "9495", ..., "2526")
seasons <- c()
for (y in start_year:end_year) {
y_current_str <- sprintf("%02d", y %% 100)
y_next_str    <- sprintf("%02d", (y + 1) %% 100)
season_str    <- paste0(y_current_str, y_next_str)
seasons       <- c(seasons, season_str)
}
# 2. Funzione per scaricare e pulire i dati di una singola stagione
get_serie_a_data <- function(season) {
url <- paste0("https://www.football-data.co.uk/mmz4281/", season, "/I1.csv")
tryCatch({
df <- read_csv(url, show_col_types = FALSE, progress = FALSE)
# Rimuove eventuali colonne vuote extra alla fine del CSV
df <- df %>% select(-matches("^\\.\\.\\."))
cols_to_select <- c("Date", "HomeTeam", "AwayTeam", "FTHG", "FTAG")
existing_cols  <- intersect(cols_to_select, names(df))
df_filtered <- df %>% select(all_of(existing_cols))
df_filtered$Season <- season
return(df_filtered)
}, error = function(e) {
message(paste("Stagione non disponibile:", season))
return(NULL)
})
}
# 3. Scaricamento ed unione di tutte le stagioni valide
all_matches_list <- lapply(seasons, get_serie_a_data)
# cache results
knitr::opts_chunk$set(cache=FALSE, echo = TRUE, eval = FALSE, message=FALSE, warning = FALSE, fig.align='center')
