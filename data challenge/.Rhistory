# Serie A (Italia) - football-data.co.uk
# Scarica tutte le stagioni dal 1993/94 a oggi, seleziona le colonne utili
# e tiene solo le righe con Date valida.
library(readr)
library(dplyr)
library(purrr)
library(lubridate)
# --- 1. Codici stagione -------------------------------------------------
# Il sito usa il formato "9394", "9495", ..., "2526", "2627"
anno_corrente <- year(Sys.Date())
mese_corrente <- month(Sys.Date())
# La stagione inizia ad agosto: prima di agosto l'ultima stagione e' iniziata l'anno prima
ultimo_inizio <- if (mese_corrente >= 8) anno_corrente else anno_corrente - 1
inizi <- 1993:ultimo_inizio
codici <- sprintf("%02d%02d", inizi %% 100, (inizi + 1) %% 100)
url_stagione <- function(codice) {
paste0("https://www.football-data.co.uk/mmz4281/", codice, "/I1.csv")
}
# --- 2. Funzione di import per una stagione -----------------------------
colonne_utili <- c("Date", "HomeTeam", "AwayTeam", "FTHG", "FTAG")
leggi_stagione <- function(codice) {
url <- url_stagione(codice)
tryCatch({
# Tutto come character: i file vecchi hanno formati/colonne diversi
df <- read_csv(
url,
col_types = cols(.default = col_character()),
locale = locale(encoding = "latin1"),
show_col_types = FALSE,
progress = FALSE
)
# Se mancano colonne, le creo come NA per evitare errori nel select
mancanti <- setdiff(colonne_utili, names(df))
for (m in mancanti) df[[m]] <- NA_character_
df %>%
select(all_of(colonne_utili)) %>%
mutate(Season = codice, .before = 1)
}, error = function(e) {
message("Stagione ", codice, " non scaricata: ", conditionMessage(e))
NULL
})
}
# --- 3. Scarico e unisco tutte le stagioni ------------------------------
dati_grezzi <- map(codici, leggi_stagione) %>% list_rbind()
# --- 4. Pulizia: Date valida, tipi corretti -----------------------------
serie_a <- dati_grezzi %>%
mutate(
# dmy() gestisce sia dd/mm/yy sia dd/mm/yyyy; le righe vuote diventano NA
Date = dmy(Date, quiet = TRUE),
FTHG = as.integer(FTHG),
FTAG = as.integer(FTAG)
) %>%
filter(!is.na(Date)) %>%
select(Date, HomeTeam, AwayTeam, FTHG, FTAG)   # solo le colonne richieste
# --- 5. Controlli rapidi ------------------------------------------------
glimpse(serie_a)
cat("Partite totali:", nrow(serie_a), "\n")
cat("Intervallo date:", format(min(serie_a$Date)), "->", format(max(serie_a$Date)), "\n")
cat("NA nelle colonne:\n")
print(colSums(is.na(serie_a)))
# Opzionale: salva in locale per non riscaricare ogni volta
# write_csv(serie_a, "serie_a_1993_oggi.csv")
library(tidyr)
library(dplyr)
risultati <- serie_a %>%
mutate(Outcome=case_when(FTHG>FTAG~"H",FTHG < FTAG ~ "A",TRUE ~ "P"))
casa <- risultati %>%
count(Team = HomeTeam, Outcome) %>%
pivot_wider(names_from=Outcome, values_from=n, values_fill=0) %>%
rename(home_W = H, home_D = P, home_L = A)
trasferta <- risultati %>%
count(Team = AwayTeam, Outcome) %>%
pivot_wider(names_from = Outcome, values_from = n, values_fill = 0) %>%
rename(away_W = A, away_D = P, away_L = H)
statistiche <- full_join(casa, trasferta, by = "Team") %>%
mutate(across(where(is.numeric), ~ replace_na(.x, 0)),
Matches = home_W + home_D + home_L + away_W + away_D + away_L,
Wins    = home_W + away_W,
Draws   = home_D + away_D,
Losses  = home_L + away_L,
Points  = 3 * Wins + Draws,
PPM     = Points / Matches) %>%
select(Team, Matches, Wins, Draws, Losses, Points, PPM) %>%
arrange(desc(PPM))
statistiche
